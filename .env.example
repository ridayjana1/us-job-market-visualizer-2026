# ─────────────────────────────────────────────────────────────
# US Job Market Visualizer 2026 — environment configuration
# Copy to `.env.local` for development. None are required to run
# the app against the committed sample dataset.
# ─────────────────────────────────────────────────────────────

# Bureau of Labor Statistics API (https://www.bls.gov/developers/)
# Registration is free and raises the rate limit to 500 queries/day.
BLS_API_KEY=

# O*NET Web Services credentials (https://services.onetcenter.org/)
ONET_USERNAME=
ONET_PASSWORD=

# Optional: Anthropic API key to regenerate occupation narrative summaries
# offline during the ETL step (scripts/build_dataset.py --ai-summaries).
ANTHROPIC_API_KEY=

# Public site URL (used for canonical/OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
